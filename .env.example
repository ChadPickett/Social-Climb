# Optional, for developers: copy to .env. Most people should use the app's Settings screen instead,
# which takes priority over these values. Every value has a safe default (demo mode).

# --- Where post data comes from: auto (Apify if its key is set, else demo) | mock | apify | graph ---
DATA_PROVIDER=auto

# Apify (https://apify.com) - managed Instagram hashtag scraper, pay per result.
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-hashtag-scraper
APIFY_RESULTS_PER_TAG=50

# Official Instagram Graph API - needs a Business/Creator IG account linked to a Facebook Page.
IG_GRAPH_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0

# --- AI agents: auto (real AI if a key is set, else placeholder) | mock | openai (any OpenAI-compatible API) ---
LLM_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- App ---
# Access key for phones. Generated automatically and handed over via the in-app QR code.
APP_TOKEN=
# DATA_DIR=  (where keys, reports and posts are stored)
MAX_HASHTAGS=8
