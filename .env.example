# Copy to .env and fill in. Every value has a safe default for demo mode.

# --- Where post data comes from: mock | apify | graph ---
DATA_PROVIDER=mock

# Apify (https://apify.com) - managed Instagram hashtag scraper, pay per result.
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-hashtag-scraper
APIFY_RESULTS_PER_TAG=150

# Official Instagram Graph API - needs a Business/Creator IG account linked to a Facebook Page.
IG_GRAPH_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0

# --- AI agents: LLM_PROVIDER=openai (any OpenAI-compatible API, see README) or mock ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- App ---
# Set this when the server is reachable from your phone/LAN; the app asks for it once.
APP_TOKEN=
DB_PATH=data/social_climb.db
MAX_HASHTAGS=8
